{%- comment -%}
  Botón "Comprar por WhatsApp".

  Lee los vendedores y la plantilla del mensaje desde los app-data metafields
  que guarda el panel de administración, sin llamadas al backend de la app.
  El reparto round robin ocurre en el navegador (assets/whatsapp-router.js).
{%- endcomment -%}

{%- assign vendors = app.metafields.whatsapp_router.vendors.value -%}

{%- assign active_count = 0 -%}
{%- for vendor in vendors -%}
  {%- if vendor.phone != blank and vendor.active != false -%}
    {%- assign active_count = active_count | plus: 1 -%}
  {%- endif -%}
{%- endfor -%}

{%- comment -%}
  Disponibilidad de lo que el cliente está viendo. Con "hide" el bloque no se
  renderiza siquiera, para que el botón no aparezca ni un instante antes de
  que el JavaScript lo evalúe.
{%- endcomment -%}
{%- assign in_stock = product.selected_or_first_available_variant.available -%}
{%- if product.has_only_default_variant -%}
  {%- assign in_stock = product.available -%}
{%- endif -%}

{%- assign stock_hides_block = false -%}
{%- if block.settings.out_of_stock_behavior == 'hide' and in_stock == false -%}
  {%- assign stock_hides_block = true -%}
{%- endif -%}

{%- assign button_label = block.settings.label -%}
{%- if block.settings.out_of_stock_behavior == 'label' and in_stock == false -%}
  {%- assign button_label = block.settings.out_of_stock_label -%}
{%- endif -%}

{%- if active_count > 0 and product and stock_hides_block == false -%}

  {%- capture vendors_json -%}
    [
    {%- assign separator = '' -%}
    {%- for vendor in vendors -%}
      {%- if vendor.phone != blank and vendor.active != false -%}
        {{ separator }}{"name": {{ vendor.name | json }}, "phone": {{ vendor.phone | json }}, "hours": {% if vendor.hours %}{"start": {{ vendor.hours.start | json }}, "end": {{ vendor.hours.end | json }}, "days": {{ vendor.hours.days | json }}}{% else %}null{% endif %}}
        {%- assign separator = ',' -%}
      {%- endif -%}
    {%- endfor -%}
    ]
  {%- endcapture -%}

  {%- assign default_message = 'Hola, me interesa este producto: {producto} - {url}' -%}
  {%- assign message_template = app.metafields.whatsapp_router.message.value | default: default_message -%}
  {%- assign base_product_url = shop.url | append: product.url -%}

  {%- comment -%}
    Variantes (talla, color...). El JavaScript usa este mapa para nombrar la
    variante que el cliente tiene seleccionada en ese momento.
  {%- endcomment -%}
  {%- capture variants_json -%}
    {
    {%- assign variant_separator = '' -%}
    {%- unless product.has_only_default_variant -%}
      {%- for variant in product.variants -%}
        {{ variant_separator }}"{{ variant.id }}": {"title": {{ variant.title | json }}, "available": {{ variant.available | json }}}
        {%- assign variant_separator = ',' -%}
      {%- endfor -%}
    {%- endunless -%}
    }
  {%- endcapture -%}

  {%- comment -%} Mensaje de reserva, con la variante activa al cargar la página {%- endcomment -%}
  {%- assign product_label = product.title -%}
  {%- assign product_url = base_product_url -%}
  {%- unless product.has_only_default_variant -%}
    {%- assign selected_variant = product.selected_or_first_available_variant -%}
    {%- assign product_label = product.title | append: ' (' | append: selected_variant.title | append: ')' -%}
    {%- assign product_url = base_product_url | append: '?variant=' | append: selected_variant.id -%}
  {%- endunless -%}
  {%- assign whatsapp_message = message_template | replace: '{producto}', product_label | replace: '{url}', product_url -%}

  {%- comment -%}
    Enlace de reserva calculado en el servidor con el primer vendedor activo.
    Si el JavaScript no carga, el botón sigue llevando a WhatsApp; cuando sí
    carga, el round robin reescribe este enlace con el vendedor que toque.
  {%- endcomment -%}
  {%- assign fallback_phone = '' -%}
  {%- for vendor in vendors -%}
    {%- if fallback_phone == '' and vendor.phone != blank and vendor.active != false -%}
      {%- assign fallback_phone = vendor.phone -%}
    {%- endif -%}
  {%- endfor -%}
  {%- assign encoded_message = whatsapp_message | url_encode | replace: '+', '%20' -%}
  {%- assign fallback_link = 'https://wa.me/' | append: fallback_phone | append: '?text=' | append: encoded_message -%}

  {{ 'whatsapp-button.css' | asset_url | stylesheet_tag }}

  {%- if block.settings.hide_add_to_cart -%}
    {%- comment -%}
      Se oculta con CSS, no solo con JavaScript: si esperáramos al script, el
      cliente vería el botón "Añadir al carrito" durante un instante y podría
      alcanzar a pulsarlo. El JS del asset sigue actuando después como refuerzo
      para los temas que insertan botones más tarde (barras fijas, etc.).
    {%- endcomment -%}
    {%- assign extra_selector = block.settings.custom_selector | replace: '<', '' | replace: '{', '' | replace: '}', '' -%}
    <style>
      form[action*="/cart/add"] [name="add"],
      form[action*="/cart/add"] button[type="submit"],
      .product-form__submit,
      .shopify-payment-button{% if extra_selector != blank %},
      {{ extra_selector }}{% endif %} {
        display: none !important;
      }
    </style>
  {%- endif -%}

  <div
    class="mvw-block{% if block.settings.full_width_mobile %} mvw-block--mobile-full{% endif %}"
    data-mvw-block
    style="
      --mvw-bg: {{ block.settings.bg_color }};
      --mvw-text: {{ block.settings.text_color }};
      --mvw-height: {{ block.settings.button_height }}px;
      --mvw-font-size: {{ block.settings.font_size }}px;
      --mvw-radius: {{ block.settings.corner_radius }}px;
      --mvw-width: {{ block.settings.button_width }}px;
      --mvw-align: {{ block.settings.alignment }};
      --mvw-note-color: {{ block.settings.note_color }};
      --mvw-space-top: {{ block.settings.spacing_top }}px;
      --mvw-space-bottom: {{ block.settings.spacing_bottom }}px;
    "
    {{ block.shopify_attributes }}
  >
    <script type="application/json" data-mvw-config>
      {
        "vendors": {{ vendors_json }},
        "shopUtcOffset": {{ 'now' | date: '%z' | json }},
        "clickEndpoint": "/apps/whatsapp-router/click",
        "productAvailable": {{ product.available | json }},
        "outOfStockBehavior": {{ block.settings.out_of_stock_behavior | json }},
        "outOfStockLabel": {{ block.settings.out_of_stock_label | json }},
        "defaultLabel": {{ block.settings.label | json }},
        "messageTemplate": {{ message_template | json }},
        "productTitle": {{ product.title | json }},
        "productUrl": {{ base_product_url | json }},
        "variants": {{ variants_json }},
        "hideAddToCart": {{ block.settings.hide_add_to_cart | json }},
        "customSelector": {{ block.settings.custom_selector | json }}
      }
    </script>

    <a
      class="mvw-button{% if block.settings.full_width %} mvw-button--full{% else %} mvw-button--fixed{% endif %}"
      data-mvw-button
      href="{{ fallback_link }}"
      target="_blank"
      rel="noopener noreferrer"
    >
      {%- if block.settings.show_icon -%}
        <svg class="mvw-button__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
          <path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.08-.3-.15-1.25-.46-2.38-1.47-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.61.14-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.6-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.01-1.04 2.47s1.06 2.87 1.21 3.07c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.75-.72 2-1.41.25-.69.25-1.28.17-1.41-.07-.13-.27-.2-.57-.35zM12.05 21.5h-.01a9.44 9.44 0 0 1-4.8-1.32l-.35-.2-3.57.93.96-3.48-.23-.36a9.4 9.4 0 0 1-1.45-5.03c0-5.2 4.24-9.44 9.46-9.44 2.53 0 4.9.99 6.68 2.78a9.38 9.38 0 0 1 2.77 6.67c0 5.2-4.24 9.45-9.46 9.45zM20.46 3.53A11.35 11.35 0 0 0 12.05.02C5.79.02.7 5.1.7 11.35c0 2 .52 3.95 1.52 5.67L.6 23.02l6.13-1.6a11.33 11.33 0 0 0 5.42 1.38h.01c6.25 0 11.34-5.08 11.34-11.33 0-3.03-1.18-5.87-3.32-8.01z"/>
        </svg>
      {%- endif -%}
      <span class="mvw-button__label" data-mvw-label>{{ button_label }}</span>
    </a>

    {%- if block.settings.show_note and block.settings.note_text != blank -%}
      <div class="mvw-note">{{ block.settings.note_text }}</div>
    {%- endif -%}
  </div>

  <script src="{{ 'whatsapp-router.js' | asset_url }}" defer></script>

{%- endif -%}

{% schema %}
{
  "name": "Botón de WhatsApp",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Texto del botón",
      "default": "Comprar por WhatsApp"
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "Mostrar icono de WhatsApp",
      "default": true
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alineación",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" },
        { "value": "right", "label": "Derecha" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Tamaño"
    },
    {
      "type": "range",
      "id": "button_height",
      "label": "Alto del botón",
      "min": 36,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Tamaño del texto",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Redondeo de esquinas",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Ancho completo en computadora",
      "default": true
    },
    {
      "type": "range",
      "id": "button_width",
      "label": "Ancho del botón",
      "min": 120,
      "max": 640,
      "step": 10,
      "unit": "px",
      "default": 320,
      "info": "Solo se aplica si desactivas el ancho completo."
    },
    {
      "type": "checkbox",
      "id": "full_width_mobile",
      "label": "Ancho completo en celular",
      "info": "Recomendado: en pantallas pequeñas un botón ancho es más fácil de pulsar.",
      "default": true
    },
    {
      "type": "header",
      "content": "Colores"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Color de fondo",
      "default": "#25D366"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color del texto",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Texto explicativo"
    },
    {
      "type": "checkbox",
      "id": "show_note",
      "label": "Mostrar texto debajo del botón",
      "info": "Explica al cliente qué pasa al pulsar. Genera confianza cuando no hay carrito de compra.",
      "default": true
    },
    {
      "type": "richtext",
      "id": "note_text",
      "label": "Texto",
      "default": "<p>Al hacer clic, un asesor te atenderá por WhatsApp y gestionará el pedido del producto que seleccionaste.</p>"
    },
    {
      "type": "color",
      "id": "note_color",
      "label": "Color del texto explicativo",
      "default": "#6B7280"
    },
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "spacing_top",
      "label": "Espacio arriba",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "spacing_bottom",
      "label": "Espacio abajo",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Productos agotados"
    },
    {
      "type": "select",
      "id": "out_of_stock_behavior",
      "label": "Cuando el producto está agotado",
      "options": [
        { "value": "show", "label": "Mostrar el botón igual" },
        { "value": "label", "label": "Mostrarlo con otro texto" },
        { "value": "hide", "label": "Ocultar el botón" }
      ],
      "info": "Se evalúa según la variante que el cliente tenga seleccionada.",
      "default": "label"
    },
    {
      "type": "text",
      "id": "out_of_stock_label",
      "label": "Texto cuando está agotado",
      "default": "Consultar disponibilidad"
    },
    {
      "type": "header",
      "content": "Botón Añadir al carrito"
    },
    {
      "type": "checkbox",
      "id": "hide_add_to_cart",
      "label": "Ocultar el botón Añadir al carrito",
      "info": "Actívalo si solo vendes por WhatsApp. Oculta también los botones de pago rápido (Shop Pay, PayPal). Déjalo apagado si quieres ofrecer las dos formas de compra.",
      "default": false
    },
    {
      "type": "text",
      "id": "custom_selector",
      "label": "Selector CSS adicional",
      "info": "Opcional. Solo si tu tema usa un botón que no se oculta automáticamente."
    }
  ]
}
{% endschema %}
