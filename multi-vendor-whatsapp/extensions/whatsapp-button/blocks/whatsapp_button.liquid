{%- comment -%}
  Botón "Comprar por WhatsApp".

  Lee los vendedores y la plantilla del mensaje desde los app-data metafields
  que guarda el panel de administración, sin llamadas al backend de la app.
  El reparto round robin ocurre en el navegador (assets/whatsapp-router.js).
{%- endcomment -%}

{%- assign vendors = app.metafields.whatsapp_router.vendors.value -%}

{%- assign active_count = 0 -%}
{%- for vendor in vendors -%}
  {%- if vendor.phone != blank and vendor.active != false -%}
    {%- assign active_count = active_count | plus: 1 -%}
  {%- endif -%}
{%- endfor -%}

{%- if active_count > 0 and product -%}

  {%- capture vendors_json -%}
    [
    {%- assign separator = '' -%}
    {%- for vendor in vendors -%}
      {%- if vendor.phone != blank and vendor.active != false -%}
        {{ separator }}{"name": {{ vendor.name | json }}, "phone": {{ vendor.phone | json }}}
        {%- assign separator = ',' -%}
      {%- endif -%}
    {%- endfor -%}
    ]
  {%- endcapture -%}

  {%- assign default_message = 'Hola, me interesa este producto: {producto} - {url}' -%}
  {%- assign message_template = app.metafields.whatsapp_router.message.value | default: default_message -%}
  {%- assign product_url = shop.url | append: product.url -%}
  {%- assign whatsapp_message = message_template | replace: '{producto}', product.title | replace: '{url}', product_url -%}

  {%- comment -%}
    Enlace de reserva calculado en el servidor con el primer vendedor activo.
    Si el JavaScript no carga, el botón sigue llevando a WhatsApp; cuando sí
    carga, el round robin reescribe este enlace con el vendedor que toque.
  {%- endcomment -%}
  {%- assign fallback_phone = '' -%}
  {%- for vendor in vendors -%}
    {%- if fallback_phone == '' and vendor.phone != blank and vendor.active != false -%}
      {%- assign fallback_phone = vendor.phone -%}
    {%- endif -%}
  {%- endfor -%}
  {%- assign encoded_message = whatsapp_message | url_encode | replace: '+', '%20' -%}
  {%- assign fallback_link = 'https://wa.me/' | append: fallback_phone | append: '?text=' | append: encoded_message -%}

  {{ 'whatsapp-button.css' | asset_url | stylesheet_tag }}

  <div
    class="mvw-block"
    data-mvw-block
    style="--mvw-bg: {{ block.settings.bg_color }}; --mvw-text: {{ block.settings.text_color }};"
    {{ block.shopify_attributes }}
  >
    <script type="application/json" data-mvw-config>
      {
        "vendors": {{ vendors_json }},
        "message": {{ whatsapp_message | json }},
        "hideAddToCart": {{ block.settings.hide_add_to_cart | json }},
        "customSelector": {{ block.settings.custom_selector | json }}
      }
    </script>

    <a
      class="mvw-button{% if block.settings.full_width %} mvw-button--full{% endif %}"
      data-mvw-button
      href="{{ fallback_link }}"
      target="_blank"
      rel="noopener noreferrer"
    >
      {%- if block.settings.show_icon -%}
        <svg class="mvw-button__icon" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true" focusable="false">
          <path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.08-.3-.15-1.25-.46-2.38-1.47-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.61.14-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.6-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.01-1.04 2.47s1.06 2.87 1.21 3.07c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.75-.72 2-1.41.25-.69.25-1.28.17-1.41-.07-.13-.27-.2-.57-.35zM12.05 21.5h-.01a9.44 9.44 0 0 1-4.8-1.32l-.35-.2-3.57.93.96-3.48-.23-.36a9.4 9.4 0 0 1-1.45-5.03c0-5.2 4.24-9.44 9.46-9.44 2.53 0 4.9.99 6.68 2.78a9.38 9.38 0 0 1 2.77 6.67c0 5.2-4.24 9.45-9.46 9.45zM20.46 3.53A11.35 11.35 0 0 0 12.05.02C5.79.02.7 5.1.7 11.35c0 2 .52 3.95 1.52 5.67L.6 23.02l6.13-1.6a11.33 11.33 0 0 0 5.42 1.38h.01c6.25 0 11.34-5.08 11.34-11.33 0-3.03-1.18-5.87-3.32-8.01z"/>
        </svg>
      {%- endif -%}
      <span class="mvw-button__label">{{ block.settings.label }}</span>
    </a>
  </div>

  <script src="{{ 'whatsapp-router.js' | asset_url }}" defer></script>

{%- endif -%}

{% schema %}
{
  "name": "Botón de WhatsApp",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Texto del botón",
      "default": "Comprar por WhatsApp"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Color de fondo",
      "default": "#25D366"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color del texto",
      "default": "#FFFFFF"
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "Mostrar icono de WhatsApp",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Botón de ancho completo",
      "default": true
    },
    {
      "type": "header",
      "content": "Botón Añadir al carrito"
    },
    {
      "type": "checkbox",
      "id": "hide_add_to_cart",
      "label": "Ocultar el botón Añadir al carrito",
      "info": "Actívalo si solo vendes por WhatsApp.",
      "default": false
    },
    {
      "type": "text",
      "id": "custom_selector",
      "label": "Selector CSS adicional",
      "info": "Opcional. Solo si tu tema usa un botón que no se oculta automáticamente."
    }
  ]
}
{% endschema %}
