{%- comment -%}
  Botón flotante de WhatsApp, visible en toda la tienda.

  Es un "app embed": el comerciante lo activa desde Editor de temas →
  Incrustaciones de aplicación, y aparece en todas las páginas sin tener que
  colocarlo bloque a bloque. Comparte el mismo reparto round robin que el
  botón de la ficha de producto (assets/whatsapp-router.js).

  En una ficha de producto envía ese producto; fuera de ella, si el cliente
  tiene artículos en el carrito, envía el pedido completo; si no, un mensaje
  general.
{%- endcomment -%}

{%- assign vendors = app.metafields.whatsapp_router.vendors.value -%}

{%- assign active_count = 0 -%}
{%- for vendor in vendors -%}
  {%- if vendor.phone != blank and vendor.active != false -%}
    {%- assign active_count = active_count | plus: 1 -%}
  {%- endif -%}
{%- endfor -%}

{%- assign hide_here = false -%}
{%- if block.settings.hide_on_product and product -%}
  {%- assign hide_here = true -%}
{%- endif -%}

{%- if active_count > 0 and hide_here == false -%}

  {%- capture vendors_json -%}
    [
    {%- assign separator = '' -%}
    {%- for vendor in vendors -%}
      {%- if vendor.phone != blank and vendor.active != false -%}
        {{ separator }}{"name": {{ vendor.name | json }}, "phone": {{ vendor.phone | json }}, "weight": {{ vendor.weight | default: 1 | json }}, "tags": {% if vendor.tags %}{{ vendor.tags | json }}{% else %}[]{% endif %}, "hours": {% if vendor.hours %}{"start": {{ vendor.hours.start | json }}, "end": {{ vendor.hours.end | json }}, "days": {{ vendor.hours.days | json }}}{% else %}null{% endif %}}
        {%- assign separator = ',' -%}
      {%- endif -%}
    {%- endfor -%}
    ]
  {%- endcapture -%}

  {%- comment -%} Mismas plantillas recomendadas que en el panel de la app {%- endcomment -%}
  {%- capture default_message -%}
Hola, me interesa este producto:
{producto} - {precio}
Cantidad: {cantidad}
{url}
  {%- endcapture -%}
  {%- capture default_cart_message -%}
Hola, quiero hacer este pedido:
{pedido}
Total: {total}
{url}
  {%- endcapture -%}
  {%- assign message_template = app.metafields.whatsapp_router.message.value | default: default_message -%}
  {%- assign cart_message_template = app.metafields.whatsapp_router.cart_message.value | default: default_cart_message -%}

  {%- comment -%} Un salto de línea reutilizable para separar renglones del pedido {%- endcomment -%}
  {%- capture newline %}
{% endcapture -%}

  {%- assign mode = 'generic' -%}
  {%- assign product_title_json = 'null' -%}
  {%- assign product_url_json = 'null' -%}
  {%- assign product_price_json = 'null' -%}
  {%- assign product_sku_json = 'null' -%}
  {%- assign product_tags_json = 'null' -%}
  {%- capture variants_json -%}{}{%- endcapture -%}
  {%- capture cart_json -%}null{%- endcapture -%}

  {%- if product -%}
    {%- assign mode = 'product' -%}
    {%- assign selected_variant = product.selected_or_first_available_variant -%}
    {%- assign base_product_url = shop.url | append: product.url -%}
    {%- assign product_price = selected_variant.price | money -%}
    {%- assign product_sku = selected_variant.sku | default: '' -%}
    {%- capture product_title_json -%}{{ product.title | json }}{%- endcapture -%}
    {%- capture product_url_json -%}{{ base_product_url | json }}{%- endcapture -%}
    {%- capture product_price_json -%}{{ product_price | json }}{%- endcapture -%}
    {%- capture product_sku_json -%}{{ product_sku | json }}{%- endcapture -%}
    {%- capture product_tags_json -%}{{ product.tags | json }}{%- endcapture -%}
    {%- capture variants_json -%}
      {
      {%- assign variant_separator = '' -%}
      {%- unless product.has_only_default_variant -%}
        {%- for variant in product.variants -%}
          {{ variant_separator }}"{{ variant.id }}": {"title": {{ variant.title | json }}, "price": {{ variant.price | money | json }}, "sku": {{ variant.sku | default: '' | json }}, "available": {{ variant.available | json }}}
          {%- assign variant_separator = ',' -%}
        {%- endfor -%}
      {%- endunless -%}
      }
    {%- endcapture -%}

    {%- assign product_label = product.title -%}
    {%- assign product_url = base_product_url -%}
    {%- unless product.has_only_default_variant -%}
      {%- assign product_label = product.title | append: ' (' | append: selected_variant.title | append: ')' -%}
      {%- assign product_url = base_product_url | append: '?variant=' | append: selected_variant.id -%}
    {%- endunless -%}
    {%- assign whatsapp_message = message_template
      | replace: '{producto}', product_label
      | replace: '{precio}', product_price
      | replace: '{cantidad}', '1'
      | replace: '{sku}', product_sku
      | replace: '{url}', product_url -%}

  {%- elsif block.settings.use_cart and cart.item_count > 0 -%}
    {%- comment -%} Pedido completo como mensaje de reserva (sin JavaScript) {%- endcomment -%}
    {%- capture cart_lines -%}
      {%- for item in cart.items -%}
        - {{ item.quantity }}× {{ item.product.title }}{% unless item.product.has_only_default_variant %} ({{ item.variant.title }}){% endunless %} — {{ item.final_line_price | money }}{% unless forloop.last %}{{ newline }}{% endunless %}
      {%- endfor -%}
    {%- endcapture -%}
    {%- capture cart_permalink -%}{{ shop.url }}/cart/{% for item in cart.items %}{{ item.variant_id }}:{{ item.quantity }}{% unless forloop.last %},{% endunless %}{% endfor %}{%- endcapture -%}
    {%- assign cart_total = cart.total_price | money -%}
    {%- assign whatsapp_message = cart_message_template
      | replace: '{pedido}', cart_lines
      | replace: '{total}', cart_total
      | replace: '{cantidad}', cart.item_count
      | replace: '{url}', cart_permalink -%}

    {%- capture cart_json -%}
      {"item_count": {{ cart.item_count }}, "total_price": {{ cart.total_price }}, "currency": {{ cart.currency.iso_code | json }}, "items": [
      {%- for item in cart.items -%}
        {"variant_id": {{ item.variant_id }}, "quantity": {{ item.quantity }}, "product_title": {{ item.product.title | json }}, "variant_title": {% if item.product.has_only_default_variant %}null{% else %}{{ item.variant.title | json }}{% endif %}, "final_line_price": {{ item.final_line_price }}}{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
      ]}
    {%- endcapture -%}

  {%- else -%}
    {%- assign whatsapp_message = block.settings.generic_message -%}
  {%- endif -%}

  {%- assign fallback_phone = '' -%}
  {%- for vendor in vendors -%}
    {%- if fallback_phone == '' and vendor.phone != blank and vendor.active != false -%}
      {%- assign fallback_phone = vendor.phone -%}
    {%- endif -%}
  {%- endfor -%}
  {%- assign encoded_message = whatsapp_message | url_encode | replace: '+', '%20' -%}
  {%- assign fallback_link = 'https://wa.me/' | append: fallback_phone | append: '?text=' | append: encoded_message -%}

  {{ 'whatsapp-float.css' | asset_url | stylesheet_tag }}

  <div
    class="mvw-float mvw-float--{{ block.settings.position }}{% if block.settings.hide_on_mobile %} mvw-float--hide-mobile{% endif %}{% if block.settings.attention_pulse %} mvw-float--pulse{% endif %}"
    data-mvw-block
    style="
      --mvw-bg: {{ block.settings.bg_color }};
      --mvw-text: {{ block.settings.text_color }};
      --mvw-float-size: {{ block.settings.button_size }}px;
      --mvw-float-font: {{ block.settings.font_size }}px;
      --mvw-float-side: {{ block.settings.offset_side }}px;
      --mvw-float-bottom: {{ block.settings.offset_bottom }}px;
    "
  >
    <script type="application/json" data-mvw-config>
      {
        "mode": {{ mode | json }},
        "cartAware": {{ block.settings.use_cart | json }},
        "vendors": {{ vendors_json }},
        "shopUtcOffset": {{ 'now' | date: '%z' | json }},
        "clickEndpoint": "/apps/whatsapp-router/click",
        "messageTemplate": {{ message_template | json }},
        "cartMessageTemplate": {{ cart_message_template | json }},
        "genericMessage": {{ block.settings.generic_message | json }},
        "shopUrl": {{ shop.url | json }},
        "currency": {{ cart.currency.iso_code | json }},
        "locale": {{ request.locale.iso_code | json }},
        "cart": {{ cart_json }},
        "productTitle": {{ product_title_json }},
        "productUrl": {{ product_url_json }},
        "productPrice": {{ product_price_json }},
        "productSku": {{ product_sku_json }},
        "productTags": {{ product_tags_json }},
        "variants": {{ variants_json }},
        "hideAddToCart": false,
        "customSelector": null,
        "availability": {
          "enabled": {{ block.settings.show_availability | json }},
          "onlineText": {{ block.settings.online_text | json }},
          "offlineText": {{ block.settings.offline_text | json }}
        }
      }
    </script>

    <a
      class="mvw-float__button{% if block.settings.show_label == false or block.settings.label == blank %} mvw-float__button--icon-only{% endif %}"
      data-mvw-button
      href="{{ fallback_link }}"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="{{ block.settings.label | default: 'Comprar por WhatsApp' | escape }}"
    >
      <svg class="mvw-float__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
        <path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.08-.3-.15-1.25-.46-2.38-1.47-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.61.14-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.6-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.01-1.04 2.47s1.06 2.87 1.21 3.07c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.75-.72 2-1.41.25-.69.25-1.28.17-1.41-.07-.13-.27-.2-.57-.35zM12.05 21.5h-.01a9.44 9.44 0 0 1-4.8-1.32l-.35-.2-3.57.93.96-3.48-.23-.36a9.4 9.4 0 0 1-1.45-5.03c0-5.2 4.24-9.44 9.46-9.44 2.53 0 4.9.99 6.68 2.78a9.38 9.38 0 0 1 2.77 6.67c0 5.2-4.24 9.45-9.46 9.45zM20.46 3.53A11.35 11.35 0 0 0 12.05.02C5.79.02.7 5.1.7 11.35c0 2 .52 3.95 1.52 5.67L.6 23.02l6.13-1.6a11.33 11.33 0 0 0 5.42 1.38h.01c6.25 0 11.34-5.08 11.34-11.33 0-3.03-1.18-5.87-3.32-8.01z"/>
      </svg>
      {%- if block.settings.show_label and block.settings.label != blank -%}
        <span class="mvw-float__label">{{ block.settings.label }}</span>
      {%- endif -%}
      {%- comment -%} Punto verde/gris: en turno o fuera de horario (lo rellena el JavaScript) {%- endcomment -%}
      <span class="mvw-float__status" data-mvw-status hidden>
        <span class="mvw-visually-hidden" data-mvw-status-text></span>
      </span>
    </a>
  </div>

  <script src="{{ 'whatsapp-router.js' | asset_url }}" defer></script>

{%- elsif request.design_mode and active_count == 0 -%}
  {%- comment -%}
    Solo dentro del editor de temas: explica por qué el botón flotante aún no
    se ve. En la tienda real no se imprime nada.
  {%- endcomment -%}
  <div
    class="mvw-placeholder"
    style="position:fixed;right:20px;bottom:20px;z-index:2147483000;max-width:280px;padding:12px 14px;border:1px dashed #8a8a8a;border-radius:8px;background:#f6f6f7;color:#303030;font:13px/1.45 -apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif"
    {{ block.shopify_attributes }}
  >
    <strong>Botón flotante WhatsApp</strong><br>
    Agrega y guarda al menos un vendedor activo en la app Multi Vendor WhatsApp para activarlo. Este aviso solo se ve en el editor.
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Botón flotante WhatsApp",
  "target": "body",
  "settings": [
    {
      "type": "paragraph",
      "content": "Muestra un botón fijo de WhatsApp en todas las páginas de la tienda. Los clics se reparten entre los mismos vendedores del panel de la app."
    },
    {
      "type": "checkbox",
      "id": "use_cart",
      "label": "Enviar el carrito como pedido",
      "info": "Fuera de las fichas de producto, si el cliente tiene artículos en el carrito, el mensaje lleva el pedido completo (productos, cantidades, total y un enlace que recrea el carrito). El texto se configura en la app.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "attention_pulse",
      "label": "Animación sutil para llamar la atención",
      "info": "Un anillo que late cada pocos segundos alrededor del botón. Se desactiva solo para quien tiene reducido el movimiento en su dispositivo.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_label",
      "label": "Mostrar texto junto al icono",
      "default": true
    },
    {
      "type": "text",
      "id": "label",
      "label": "Texto del botón",
      "default": "Escríbenos"
    },
    {
      "type": "text",
      "id": "generic_message",
      "label": "Mensaje fuera de las fichas de producto",
      "info": "Se usa en el inicio, colecciones y demás páginas cuando el carrito está vacío. En una ficha de producto siempre se envía el mensaje configurado en la app, con el producto y la variante.",
      "default": "Hola, quiero información sobre sus productos."
    },
    {
      "type": "header",
      "content": "Disponibilidad en vivo"
    },
    {
      "type": "checkbox",
      "id": "show_availability",
      "label": "Punto verde cuando hay alguien atendiendo",
      "info": "Usa los horarios de la app. Solo aparece si al menos un vendedor tiene horario configurado.",
      "default": true
    },
    {
      "type": "text",
      "id": "online_text",
      "label": "Texto al pasar el cursor (en turno)",
      "default": "En línea · te respondemos en minutos"
    },
    {
      "type": "text",
      "id": "offline_text",
      "label": "Texto al pasar el cursor (fuera de horario)",
      "info": "Puedes usar {dia} y {hora}: se reemplazan por la próxima apertura.",
      "default": "Fuera de horario · te respondemos {dia} a las {hora}"
    },
    {
      "type": "header",
      "content": "Posición"
    },
    {
      "type": "select",
      "id": "position",
      "label": "Esquina",
      "options": [
        { "value": "right", "label": "Abajo a la derecha" },
        { "value": "left", "label": "Abajo a la izquierda" }
      ],
      "default": "right"
    },
    {
      "type": "range",
      "id": "offset_side",
      "label": "Separación lateral",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "offset_bottom",
      "label": "Separación inferior",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 20,
      "info": "Súbelo si tu tema ya tiene otro botón flotante en esa esquina."
    },
    {
      "type": "header",
      "content": "Apariencia"
    },
    {
      "type": "range",
      "id": "button_size",
      "label": "Tamaño",
      "min": 44,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Tamaño del texto",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Color de fondo",
      "default": "#25D366"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color del texto",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Dónde mostrarlo"
    },
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "Ocultarlo en celular",
      "info": "Útil si tu tema ya muestra una barra fija de compra en pantallas pequeñas.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_on_product",
      "label": "Ocultarlo en las fichas de producto",
      "info": "Actívalo si ya colocaste el botón dentro de la página de producto y no quieres los dos a la vez.",
      "default": false
    }
  ]
}
{% endschema %}
